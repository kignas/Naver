# Local verification output and the read-only original frontend reference
verify/
reference/

# Original reference frontend copies must never be committed here.
# The ported app lives under navereat/ and is not affected by these root patterns.
/*.html
/*.js
/*.css
/assets/
/css/
/js/

# Tooling
node_modules/
dist/
.DS_Store
*.local

# Agent workspace notes
.openhands/

# Signing material; only the committed debug key is allowed
*.keystore
!navereat/android/app/navereat-debug.keystore
*.jks
.secrets/

# Android build outputs
navereat/android/.gradle/
navereat/android/build/
navereat/android/app/build/
navereat/android/local.properties
