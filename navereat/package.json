{
  "name": "navereat",
  "private": true,
  "version": "1.0.41",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && eslint .",
    "android:prepare": "npm run build && npx cap sync android",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "assets": "node scripts/generate-brand-assets.mjs && npx capacitor-assets generate --android && node scripts/patch-android-icons.mjs",
    "visual": "vite-node scripts/visual-check.ts",
    "parity": "vite-node scripts/design-parity.ts",
    "scroll-check": "node scripts/scroll-check.cjs",
    "perf-check": "node scripts/perf-check.mjs",
    "perf-transitions": "node scripts/transition-check.mjs after",
    "statusbar-check": "vite-node scripts/statusbar-check.ts",
    "nav-check": "node scripts/nav-check.mjs",
    "transitions:frames": "node scripts/transition-frames.mjs after",
    "motion:evidence": "node scripts/motion-evidence.mjs",
    "sticky-check": "node scripts/sticky-check.mjs",
    "route-motion-check": "node scripts/route-motion-check.mjs",
    "stress-walk": "node scripts/stress-walk.mjs",
    "tap-pay-check": "node scripts/tap-pay-check.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.28",
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "pixelmatch": "^5.3.0",
    "playwright-core": "^1.65.1",
    "pngjs": "^5.0.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.11",
    "vite-node": "^6.0.0"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
